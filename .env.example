# SteamRAG Cloud Server — Example Environment Configuration
# Copy this file to .env and fill in your keys (never commit .env to Git)

# Google AI Studio API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: Steam Web API Key for GetOwnedGames library sync (https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=

# Optional: Google Cloud OAuth 2.0 Web Client Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: SteamDB Session Cookie
STEAMDB_COOKIE=

# Optional: Reddit OAuth API Credentials (for live r/IndieGaming & community consensus)
# Create a free "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
