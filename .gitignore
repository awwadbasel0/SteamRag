# ============================================================================
# SteamRAG Cloud Server — Root .gitignore
# Prevents leaking databases, user sessions, API keys, OAuth tokens, and build artifacts
# ============================================================================

# 1. Databases & Persisted User Sessions / API Keys (CRITICAL)
backend/data/
backend/app/data/
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# 2. Environment Variables, Secrets & Credentials (CRITICAL)
.env
.env.*
!.env.example
*.pem
*.key
*credentials*.json
*client_secret*.json
*service_account*.json

# 3. Python Virtual Environments & Bytecode
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 4. Node / Frontend Dependencies & Build Outputs
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. OS, Editor & Runtime Logs
.DS_Store
Thumbs.db
*.log
*.pid
*.seed
*.pid.lock
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~
